{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Contract verifier: create environment",
      "type": "process",
      "command": "python",
      "args": ["-m", "venv", "${workspaceFolder}/.venv-contracts"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Contract verifier: set up environment",
      "type": "process",
      "command": "${workspaceFolder}/.venv-contracts/Scripts/python.exe",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "${workspaceFolder}/data_contracts/verification-requirements.txt"
      ],
      "dependsOn": "Contract verifier: create environment",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Contract verifier: run",
      "type": "process",
      "command": "${workspaceFolder}/.venv-contracts/Scripts/python.exe",
      "args": ["${workspaceFolder}/data_contracts/verify_contracts.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
