{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "system": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "string",
      "pattern": "\\S"
    },
    "defaultDisplayName": {
      "type": "string",
      "pattern": "\\S"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$",
              "maxLength": 64
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "fields"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "type": {
            "const": "integer"
          },
          "default": {
            "type": "integer"
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "sourceReview": {
                "type": "string",
                "pattern": "\\S"
              },
              "requirementRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "sourceRegisterRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "sourceRefs",
          "type",
          "default",
          "minimum",
          "maximum"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "type": {
            "const": "number"
          },
          "expression": {
            "$ref": "#/$defs/expression"
          },
          "unit": {
            "type": "string",
            "pattern": "\\S"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "sourceReview": {
                "type": "string",
                "pattern": "\\S"
              },
              "requirementRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "sourceRegisterRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "sourceRefs",
          "type",
          "expression"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entityType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "modifierTargets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$",
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "sourceReview": {
          "type": "string",
          "pattern": "\\S"
        },
        "requirementRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "sourceRegisterRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "system",
    "label",
    "defaultDisplayName",
    "sections",
    "inputs",
    "derived",
    "entityType",
    "modifierTargets"
  ],
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "constant"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "field"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$",
              "maxLength": 64
            }
          },
          "required": [
            "op",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "floor"
            },
            "value": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "divide"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "multiply"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "equal"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "if"
            },
            "condition": {
              "$ref": "#/$defs/expression"
            },
            "then": {
              "$ref": "#/$defs/expression"
            },
            "else": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "condition",
            "then",
            "else"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
